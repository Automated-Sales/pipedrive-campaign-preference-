# Pipedrive settings
PIPEDRIVE_API_TOKEN=replace_me
PIPEDRIVE_COMPANY_DOMAIN=replace_me_without_.pipedrive.com

# Pipedrive Person custom field API keys
# Create these in Pipedrive > Settings > Data fields > Person.
TOKEN_FIELD_KEY=replace_with_person_field_api_key_for_email_preference_token
PREFERENCES_FIELD_KEY=replace_with_person_field_api_key_for_email_categories_subscribed_to

# The multi-option IDs from the Pipedrive field options.
# Use the actual option IDs from the Person field definition.
CATEGORY_OPTIONS=[{"id":1,"slug":"newsletters","label":"Newsletters"},{"id":2,"slug":"product-updates","label":"Product updates"},{"id":3,"slug":"events","label":"Events"},{"id":4,"slug":"offers","label":"Offers"}]

# Optional
PORT=3000
BASE_URL=https://preferences.yourclientdomain.com
